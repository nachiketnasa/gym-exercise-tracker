# Backend configuration. Every variable the typed settings object
# (app/config.py) reads is listed here. Copy to .env for local development
# (the repo-root .env is also read); real environment variables win.

# Required. SQLAlchemy / Postgres connection URL. No default: if it is unset,
# the settings object raises an error naming DATABASE_URL.
DATABASE_URL=postgresql://gym:gym@localhost:5432/gym_tracker

# Optional. Origins allowed by CORS. Defaults to http://localhost:5173 (the
# Vite dev server) when unset. Override with a comma-separated list or a JSON
# array:
#   CORS_ORIGINS=http://localhost:5173,http://localhost:4173
#   CORS_ORIGINS=["http://localhost:5173"]

# Optional. Deployment environment name (local / dev / prod). Defaults to local.
ENVIRONMENT=local

# Optional. The test suite runs against a dedicated database so it never
# touches the dev data. By default that is DATABASE_URL's name plus a "_test"
# suffix (gym_tracker_test), created automatically on first run.
# TEST_DATABASE_URL=postgresql://gym:gym@localhost:5432/gym_tracker_test
