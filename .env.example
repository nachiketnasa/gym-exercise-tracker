# Copy to .env for local development. Matches the credentials in docker-compose.yml.
DATABASE_URL=postgresql://gym:gym@localhost:5432/gym_tracker

# Optional. The test suite runs against a dedicated database so it never touches
# the dev data. By default that database is DATABASE_URL's name with a "_test"
# suffix (gym_tracker_test), created automatically on first run. Set this to
# point the tests somewhere else.
# TEST_DATABASE_URL=postgresql://gym:gym@localhost:5432/gym_tracker_test
